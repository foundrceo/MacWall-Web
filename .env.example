# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_NAME=MacWall

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (server only) ---
STRIPE_SECRET_KEY=
# Optional legacy override; prefer price map in code for MacWall offers
STRIPE_PRICE_ID_USD=
# Stripe webhook signing secret (when webhook route is configured)
# STRIPE_WEBHOOK_SECRET=

# --- Server-only (configure in deployment; never commit values) ---
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# On-demand catalog ISR — send as `x-revalidate-secret` header
# REVALIDATE_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
LICENSE_EMAIL_FROM=
LICENSE_EMAIL_SUPPORT=
LICENSE_EMAIL_SITE_URL=
LICENSE_EMAIL_LOGO_URL=

# --- Cloudflare R2 (catalog + installers) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_INSTALLERS_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
# Absolute HTTPS URL for `/download/latest` 302 target
# MACWALL_INSTALLER_REDIRECT_URL=

# --- Optional AI (admin wallpaper metadata) ---
OPENAI_API_KEY=

# --- Analytics (public) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_AHREFS_WEB_ANALYTICS_KEY=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_X_ADS_PIXEL_ID=
NEXT_PUBLIC_AFFONSO_PROGRAM_ID=
NEXT_PUBLIC_MACWALL_AFFILIATE_PORTAL_URL=
NEXT_PUBLIC_MACWALL_PRO_CHECKOUT_URL=

# --- Analytics (server) ---
# Optional DataFast bot-traffic auth token (dfbot_...) — create in DataFast Bot traffic settings
DATAFAST_BOT_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_API_ACCESS_TOKEN=
TIKTOK_EVENTS_API_TEST_EVENT_CODE=

# --- Stripe fee display (admin sales, optional) ---
STRIPE_FEE_PERCENT=
STRIPE_FEE_FIXED=
