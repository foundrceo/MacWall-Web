# Copy to .env. `npm run dev:cf` also picks up .env unless a .dev.vars file
# exists. Most of the marketing site renders with everything below empty.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
# Price IDs are optional. Defaults live in lib/license/stripe-price-map.ts.
STRIPE_PRICE_PRO_GLOBAL=
STRIPE_PRICE_PRO_PLUS_GLOBAL=
STRIPE_PRICE_UPGRADE_PRO_PLUS_GLOBAL=
STRIPE_PRICE_ADDON_5_MACS_GLOBAL=
STRIPE_PRICE_PRO_INDIA=
STRIPE_PRICE_PRO_PLUS_INDIA=
STRIPE_PRICE_UPGRADE_PRO_PLUS_INDIA=
STRIPE_PRICE_ADDON_5_MACS_INDIA=
# Legacy single-price overrides, see lib/license/plans.ts
STRIPE_PRICE_ID_USD=
STRIPE_PRICE_ID_PRO=
# Only used to estimate fees on the admin sales page
STRIPE_FEE_PERCENT=
STRIPE_FEE_FIXED=

# Admin and internal endpoints
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
REVALIDATE_SECRET=
CRON_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Cloudflare R2 (catalog media and installers)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_INSTALLERS_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
# Absolute https URL that /download/latest redirects to
MACWALL_INSTALLER_REDIRECT_URL=

# Admin wallpaper metadata suggestions (optional)
OPENAI_API_KEY=
OPENAI_WALLPAPER_METADATA_MODEL=

# Analytics and ads, public. Leave empty to disable each one.
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_AHREFS_WEB_ANALYTICS_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_X_ADS_PIXEL_ID=
NEXT_PUBLIC_AFFONSO_PROGRAM_ID=
NEXT_PUBLIC_MACWALL_AFFILIATE_PORTAL_URL=
NEXT_PUBLIC_MACWALL_PRO_CHECKOUT_URL=

# Analytics, server side (conversion APIs)
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_API_ACCESS_TOKEN=
TIKTOK_EVENTS_API_TEST_EVENT_CODE=

# Supabase edge functions. The site doesn't read these; set them with
# `supabase secrets set`. Each function lists the rest in its Deno.env.get calls.
APP_NAME=MacWall
STRIPE_WEBHOOK_SECRET=
LICENSE_EMAIL_FROM=
LICENSE_EMAIL_SUPPORT=
LICENSE_EMAIL_SITE_URL=
LICENSE_EMAIL_LOGO_URL=
X_PIXEL_ID=
X_PIXEL_TOKEN=
