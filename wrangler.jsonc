{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers deployment of macwall.app (vinext). `next build` for
  // Vercel is unchanged, so both can run until DNS moves.
  "name": "macwall",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  // Run next to Supabase (the Vercel project was pinned to sin1 for this).
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // macwall.app serves from this Worker; www redirects to the apex in
  // next.config. preview.macwall.app stays as a test hostname.
  "routes": [
    { "pattern": "macwall.app", "custom_domain": true },
    { "pattern": "www.macwall.app", "custom_domain": true },
    { "pattern": "preview.macwall.app", "custom_domain": true }
  ],
  // Replaces the `crons` that were in vercel.json (worker/crons.ts dispatches).
  "triggers": { "crons": ["*/5 * * * *", "*/10 * * * *", "7,22,37,52 * * * *"] },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // next/image → Cloudflare Images.
  "images": { "binding": "IMAGES" },
  // unstable_cache / data cache (vinext kvDataAdapter); provisioned on deploy.
  "kv_namespaces": [{ "binding": "VINEXT_KV_CACHE" }]
}
