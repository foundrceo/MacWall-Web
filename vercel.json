{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "ignoreCommand": "B=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git diff --quiet $B HEAD && exit 1; git diff --quiet $B HEAD -- . ':(exclude)supabase' ':(exclude)tests' ':(exclude)*.md' ':(exclude)LICENSE'",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/checkout-recovery",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/trial-ended",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/prune-checkouts",
      "schedule": "7,22,37,52 * * * *"
    }
  ]
}
